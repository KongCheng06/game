class Arrow:
    """网格中的一个单格箭头"""

    def __init__(self, row, col, direction):
        self.row = row
        self.col = col
        self.direction = direction


class Button:
    """简单的矩形按钮：负责绘制与点击判定"""

    def __init__(self, rect, text, callback, font=FONT_BTN):
        self.rect = pygame.Rect(rect)
        self.text = text
        self.callback = callback
        self.font = font
        self.disabled = False

    def draw(self, screen, mouse):
        hovered = not self.disabled and self.rect.collidepoint(mouse)
        bg, fg, border = BTN_BG, TEXT, BTN_BORDER
        if self.disabled:
            bg, fg, border = BTN_DISABLED_BG, DIM, (48, 54, 82)
        elif hovered:
            bg = BTN_HOVER
        pygame.draw.rect(screen, bg, self.rect, border_radius=10)
        pygame.draw.rect(screen, border, self.rect, 2, border_radius=10)
        surf = self.font.render(self.text, True, fg)
        screen.blit(surf, surf.get_rect(center=self.rect.center))

    def hit(self, pos):
        return self.rect.collidepoint(pos)


class LevelButton(Button):
    """选关界面的关卡按钮：显示关卡号、已获得星级或"未解锁"状态"""

    def __init__(self, rect, level, callback):
        super().__init__(rect, "", callback)
        self.level = level

    def draw(self, screen, mouse, stars, locked):
        hovered = not locked and self.rect.collidepoint(mouse)
        bg = BTN_HOVER if hovered else BTN_BG
        border = ACCENT
        label_color = TEXT
        if locked:
            bg, border, label_color = (22, 25, 44), (48, 54, 82), DIM
        pygame.draw.rect(screen, bg, self.rect, border_radius=12)
        pygame.draw.rect(screen, border, self.rect, 2, border_radius=12)
        label = FONT_MED.render(f"第 {self.level} 关", True, label_color)
        screen.blit(label, label.get_rect(center=(self.rect.centerx, self.rect.top + 26)))
        if locked:
            t = FONT_SMALL.render("未解锁", True, DIM)
            screen.blit(t, t.get_rect(center=(self.rect.centerx, self.rect.top + 58)))
        else:
            for i in range(3):
                draw_star(screen, self.rect.centerx - 26 + i * 26, self.rect.top + 58, 10,
                          GOLD if i < stars else (60, 70, 110), filled=i < stars)


class Game:
    """游戏主逻辑：选关、关卡管理、点击判定、动画、音效与绘制"""

    def __init__(self):
        self.quit = False
        self.progress = load_progress()   # 存档：解锁进度 / 星级 / 无尽最高分
        self.state = "menu"               # menu / play / win / fail
        self.mode = "level"               # level（固定关卡）/ endless（无尽模式）
        self.level = 1
        self.anim = None                  # 当前播放的动画
        self.floaters = []                # 浮动提示文字
        self.particles = []               # 粒子（箭头飞出时的光点）
        self.overlay_btns = []            # 结算界面按钮
        self.ai_solving = False           # AI 求解中
        self.ai_order = []                # AI 预计算的消除顺序
        self.hint = None                  # 提示高亮：{"cell": (r,c), "t": 剩余秒}
        self.hints_left = 3               # 本关剩余提示次数
        self.undo_stack = []              # 已消除箭头的撤销栈
        self.elapsed = 0.0                # 本关用时
        self.score = 0                    # 本关得分
        self.win_stars = 0                # 本关获胜星级
        # 游戏中的四个操作按钮
        self.play_btns = []
        x = (WINDOW_W - 150 - 150 - 120 - 160 - 12 * 3) // 2
        for text, w, cb in (("重新开始本关", 150, self.restart_level),
                            ("提示 ×3", 150, self.use_hint),
                            ("撤销", 120, self.undo_last),
                            ("AI 求解", 160, self.start_ai_solve)):
            self.play_btns.append(Button(pygame.Rect(x, 772, w, 40), text, cb))
            x += w + 12
        self.restart_btn, self.hint_btn, self.undo_btn, self.ai_btn = self.play_btns
        # 选关界面按钮
        self.level_btns = []
        for n in range(1, len(LEVELS) + 1):
            col, row = (n - 1) % 3, (n - 1) // 3
            self.level_btns.append(LevelButton(pygame.Rect(55 + col * 190, 220 + row * 100, 170, 80),
                                               n, lambda n=n: self.start_level(n)))
        self.menu_btns = [
            Button(pygame.Rect(0, 0, 300, 54), "无尽模式", self.start_endless),
            Button(pygame.Rect(0, 0, 300, 54), "退出游戏", self.quit_game),
        ]
        self.menu_btns[0].rect.center = (WINDOW_W // 2, 470)
        self.menu_btns[1].rect.center = (WINDOW_W // 2, 545)

    # ---------------- 关卡管理 ----------------
    # [feat] 增加关卡切换功能：按 LEVELS 配置加载指定关卡，并重置本关所有状态
    def load_level(self, level):
        self.mode = "level"
        self.level = level
        grid, count, mistakes, bias = LEVELS[level - 1]
        self.grid = grid
        layout = None
        while layout is None:
            for _ in range(100):      # 多次随机尝试，避免密度过高时生成失败
                layout = generate_arrows(grid, count, bias)
                if layout is not None:
                    break
            if layout is None:        # 仍然失败则降低箭头数量再试
                count -= 1
        self.layout = layout
        self.mistakes_total = mistakes
        self._reset_level()

    def load_endless(self, index):
        """无尽模式：难度随层数持续递增，上限封顶后保持不变（保证可生成）"""
        self.mode = "endless"
        self.level = index
        grid = min(4 + (index - 1) // 3, 6)
        count = min({4: 8, 5: 13, 6: 20}[grid], 4 + 2 * index)
        mistakes = max(2, 5 - (index - 1) // 3)
        bias = min(0.8, 0.05 + 0.1 * index)
        self.grid = grid
        layout = None
        while layout is None:
            for _ in range(100):
                layout = generate_arrows(grid, count, bias)
                if layout is not None:
                    break
            if layout is None:
                count -= 1
        self.layout = layout
        self.mistakes_total = mistakes
        self._reset_level()

    def _reset_level(self):
        """进入/重开一关：布局不变，重置箭头、失误机会与本关全部统计"""
        self.arrows = {(r, c): Arrow(r, c, d) for (r, c), d in self.layout.items()}
        self.mistakes_left = self.mistakes_total
        self.anim = None
        self.floaters.clear()
        self.particles.clear()
        self.overlay_btns = []
        self.ai_solving = False
        self.ai_order = []
        self.hint = None
        self.hints_left = 3
        self.undo_stack = []
        self.elapsed = 0.0
        self.score = 0
        self.state = "play"

    def restart_level(self):
        self._reset_level()

    def start_level(self, n):
        self.load_level(n)

    def start_endless(self):
        self.load_endless(1)

    def next_level(self):
        if self.mode == "endless":
            self.load_endless(self.level + 1)
        elif self.level < len(LEVELS):
            self.load_level(self.level + 1)
        else:
            self.enter_menu()

    def enter_menu(self):
        self.state = "menu"
        self.anim = None
        self.ai_solving = False

    def quit_game(self):
        self.quit = True

    # ---------------- 坐标换算 ----------------
    def board_rect(self):
        size = self.grid * CELL
        ox = (WINDOW_W - size) // 2
        oy = TOP_H + (WINDOW_H - TOP_H - BOTTOM_H - size) // 2
        return pygame.Rect(ox, oy, size, size)

    def cell_rect(self, row, col):
        br = self.board_rect()
        return pygame.Rect(br.left + col * CELL, br.top + row * CELL, CELL, CELL)

    def cell_at(self, pos):
        """把鼠标坐标换算成格子 (row, col)，不在棋盘内返回 None"""
        br = self.board_rect()
        if not br.collidepoint(pos):
            return None
        return ((pos[1] - br.top) // CELL, (pos[0] - br.left) // CELL)

    # ---------------- 点击与判定（核心逻辑） ----------------
    # 【核心】所有鼠标点击的统一入口：按当前界面状态分发给对应按钮或棋盘格子
    def handle_click(self, pos):
        if self.state == "menu":
            for btn in self.level_btns:
                if btn.hit(pos):
                    if btn.level <= self.progress["unlocked"]:
                        play_sound("click")
                        self.start_level(btn.level)
                    else:
                        play_sound("hit")   # 未解锁提示音
                    return
            for btn in self.menu_btns:
                if btn.hit(pos):
                    play_sound("click")
                    btn.callback()
                    return
        elif self.state == "play":
            for btn in self.play_btns:
                if not btn.disabled and btn.hit(pos):
                    play_sound("click")
                    btn.callback()
                    return
            if self.ai_solving or self.anim:
                return      # AI 求解 / 动画期间锁定棋盘输入
            cell = self.cell_at(pos)
            if cell and cell in self.arrows:
                self.click_arrow(self.arrows[cell])
        elif self.state in ("win", "fail"):
            for btn in self.overlay_btns:
                if btn.hit(pos):
                    play_sound("click")
                    btn.callback()
                    return

    # 【核心】点击箭头：路径检测 -> 飞出消除 或 碰撞反馈
    # [feat] 增加碰撞反馈和失误次数：被阻挡时晃动+变红+文字提示，每碰撞一次扣 1 次失误机会
    def click_arrow(self, arrow):
        rect = self.cell_rect(arrow.row, arrow.col)
        blocker = first_arrow_on_path(arrow.row, arrow.col, arrow.direction,
                                      self.arrows, self.grid)
        if blocker is not None:
            # 路径上有其他箭头：无法消除，消耗 1 次失误机会并提示碰撞
            self.mistakes_left -= 1
            self.score = max(0, self.score - 30)
            play_sound("hit")
            self.anim = {"kind": "shake", "arrow": arrow, "blocker": blocker,
                         "t": 0.0, "dur": 0.45}
            self.floaters.append({"text": "被挡住了！", "x": rect.centerx,
                                  "y": rect.top - 6, "t": 0.0, "dur": 0.9})
            if self.mistakes_left <= 0:
                self.set_state("fail")
        else:
            # 路径畅通：箭头飞出棋盘
            play_sound("fly")
            dc, dr = DIR_VECTORS[arrow.direction]
            self.anim = {"kind": "fly", "arrow": arrow, "dc": dc, "dr": dr,
                         "rect0": rect, "dist": self.fly_distance(arrow.direction, rect),
                         "t": 0.0, "dur": 0.35}

    def fly_distance(self, direction, rect):
        """箭头飞到完全离开棋盘所需的移动距离"""
        br = self.board_rect()
        if direction == "right":
            return br.right - rect.left + 20
        if direction == "left":
            return rect.right - br.left + 20
        if direction == "down":
            return br.bottom - rect.top + 20
        return rect.bottom - br.top + 20

    # ---------------- 增强功能：提示 / 撤销 / AI ----------------
    def use_hint(self):
        """提示：高亮一个路径畅通、可直接消除的箭头（每关 3 次）"""
        if self.anim or self.ai_solving or self.hints_left <= 0:
            return
        for a in self.arrows.values():
            if first_arrow_on_path(a.row, a.col, a.direction, self.arrows, self.grid) is None:
                self.hints_left -= 1
                self.hint = {"cell": (a.row, a.col), "t": 2.5}
                play_sound("hint")
                return

    def undo_last(self):
        """撤销上一步：恢复最近消除的箭头并扣回得分（失误不可撤销）"""
        if self.state != "play" or self.anim or self.ai_solving:
            return
        if not self.undo_stack:
            return
        r, c, d = self.undo_stack.pop()
        self.arrows[(r, c)] = Arrow(r, c, d)
        self.score = max(0, self.score - 100)
        play_sound("undo")

    def start_ai_solve(self):
        """AI 自动求解：按贪心顺序逐个点击安全箭头，0 失误通关"""
        if self.anim or self.ai_solving:
            return
        order = compute_solution(self.arrows, self.grid)
        if not order:
            return
        self.ai_solving = True
        self.ai_order = order
        self.ai_step()

    def ai_step(self):
        """AI 求解的下一步：按预计算顺序点击下一个仍存在的箭头"""
        if not self.ai_order:
            self.ai_order = compute_solution(self.arrows, self.grid) or []
        while self.ai_order:
            cell = self.ai_order.pop(0)
            if cell in self.arrows:
                self.click_arrow(self.arrows[cell])
                return
        self.ai_solving = False

    # ---------------- 状态切换与结算 ----------------
    def set_state(self, state):
        self.state = state
        self.ai_solving = False
        if state == "win":
            play_sound("win")
            if self.mode == "level":
                # 星级评价：0 失误 3 星，1 次失误 2 星，其余 1 星
                used = self.mistakes_total - self.mistakes_left
                self.win_stars = 3 if used == 0 else 2 if used == 1 else 1
                best = self.progress["stars"].get(self.level, 0)
                self.progress["stars"][self.level] = max(best, self.win_stars)
                if self.level < len(LEVELS):
                    self.progress["unlocked"] = max(self.progress["unlocked"], self.level + 1)
            else:
                self.progress["endless_best"] = max(self.progress["endless_best"], self.score)
            save_progress(self.progress)
            if self.mode == "level" and self.level < len(LEVELS):
                self._add_overlay_buttons([("进入下一关", self.next_level),
                                           ("返回选关", self.enter_menu)])
            elif self.mode == "endless":
                self._add_overlay_buttons([("继续挑战", self.next_level),
                                           ("返回选关", self.enter_menu)])
            else:
                self._add_overlay_buttons([("返回选关", self.enter_menu)])
        elif state == "fail":
            play_sound("fail")
            self._add_overlay_buttons([("重新开始", self.restart_level),
                                       ("返回选关", self.enter_menu)])

    def _add_overlay_buttons(self, pairs):
        self.overlay_btns = []
        n = len(pairs)
        for i, (text, cb) in enumerate(pairs):
            btn = Button(pygame.Rect(0, 0, 220, 46), text, cb)
            btn.rect.center = (int(WINDOW_W // 2 + (i - (n - 1) / 2) * 244), 448)
            self.overlay_btns.append(btn)

    def spawn_particles(self, x, y, color):
        """在箭头飞出棋盘的位置生成一圈光点粒子"""
        for _ in range(12):
            ang = random.uniform(0, 2 * math.pi)
            spd = random.uniform(70, 240)
            self.particles.append({"x": x, "y": y,
                                   "vx": math.cos(ang) * spd, "vy": math.sin(ang) * spd,
                                   "t": 0.0, "dur": random.uniform(0.25, 0.55), "color": color})

    # ---------------- 更新与动画（核心循环） ----------------
    # 【核心】每帧更新：推进动画/粒子/提示计时，累计本关用时
    def update(self, dt):
        if self.state == "play":
            self.elapsed += dt
        if self.anim:
            self.anim["t"] += dt
            if self.anim["t"] >= self.anim["dur"]:
                self.finish_anim()
        for f in self.floaters:
            f["t"] += dt
        self.floaters = [f for f in self.floaters if f["t"] < f["dur"]]
        for p in self.particles:
            p["x"] += p["vx"] * dt
            p["y"] += p["vy"] * dt
            p["t"] += dt
        self.particles = [p for p in self.particles if p["t"] < p["dur"]]
        if self.hint:
            self.hint["t"] -= dt
            if self.hint["t"] <= 0 or self.hint["cell"] not in self.arrows:
                self.hint = None

    # 【核心】动画结束回调：飞出动画在此真正消除箭头、计分并判定胜负
    def finish_anim(self):
        anim, self.anim = self.anim, None
        if anim["kind"] == "fly":
            arrow = anim["arrow"]
            del self.arrows[(arrow.row, arrow.col)]
            self.score += 100
            self.undo_stack.append((arrow.row, arrow.col, arrow.direction))
            if self.hint and self.hint["cell"] == (arrow.row, arrow.col):
                self.hint = None
            ex = anim["rect0"].centerx + anim["dc"] * anim["dist"]
            ey = anim["rect0"].centery + anim["dr"] * anim["dist"]
            self.spawn_particles(ex, ey, DIR_COLORS[arrow.direction])
            if not self.arrows:      # 本关箭头全部消除 -> 过关
                self.set_state("win")
            elif self.ai_solving:
                self.ai_step()
        # shake 动画结束无需额外处理（颜色在绘制时已恢复）

    # ---------------- 绘制 ----------------
    def draw(self, screen):
        if self.state == "menu":
            self.draw_menu(screen)
        else:
            self.draw_play(screen)

    def draw_menu(self, screen):
