# 音效：用正弦波实时合成，无需外部音频文件
# ---------------------------------------------------------------------------
SOUNDS = {}  # 名称 -> pygame.mixer.Sound，初始化失败时保持为空（静音运行）


def synth_sound(segments, volume=0.35):
    """用正弦波合成 16 位单声道 WAV 数据，segments 为 [(起频, 止频, 时长)] 列表"""
    import array
    rate = 22050
    total = sum(d for _, _, d in segments) + 0.05
    samples = array.array("h", bytes(2 * int(rate * total)))
    pos = 0
    for f0, f1, dur in segments:
        m = int(rate * dur)
        phase = 0.0
        for i in range(m):
            f = f0 + (f1 - f0) * (i / max(1, m - 1))
            phase += 2 * math.pi * f / rate
            env = min(1.0, i / (0.008 * rate), (m - i) / (0.02 * rate))  # 起落包络防爆音
            samples[pos + i] = int(32000 * volume * env * math.sin(phase))
        pos += m
    return samples.tobytes()


def init_sounds():
    """初始化合成音效；音频设备不可用时静音运行，不影响游戏"""
    try:
        pygame.mixer.init(22050, -16, 1, 512)
    except pygame.error:
        return
    defs = {
        "fly":  [(500, 950, 0.16)],                          # 飞出：上扬滑音
        "hit":  [(180, 90, 0.22)],                           # 碰撞：低沉下滑
        "win":  [(523, 523, 0.10), (659, 659, 0.10), (784, 784, 0.18)],   # 过关琶音
        "fail": [(330, 330, 0.12), (247, 247, 0.12), (185, 185, 0.22)],   # 失败下行
        "click": [(760, 760, 0.05)],                         # 按钮短音
        "hint":  [(880, 1400, 0.12)],                        # 提示音
        "undo":  [(620, 420, 0.10)],                         # 撤销音
    }
    for name, segs in defs.items():
        try:
            SOUNDS[name] = pygame.mixer.Sound(buffer=synth_sound(segs))
        except pygame.error:
            SOUNDS[name] = None


def play_sound(name):
    """播放指定音效；未初始化时静默跳过"""
    s = SOUNDS.get(name)
    if s:
        s.play()


