def fmt_time(sec):
    """秒数格式化为 mm:ss"""
    return f"{int(sec) // 60:02d}:{int(sec) % 60:02d}"


def scaled_color(c, f):
    """颜色按系数变暗（用于霓虹光晕与粒子渐隐）"""
    return tuple(int(min(255, x * f)) for x in c)


def lerp_color(c1, c2, t):
    """颜色线性插值，t 取值 0~1"""
    return tuple(int(a + (b - a) * t) for a, b in zip(c1, c2))


def grow_polygon(points, m):
    """多边形按包围盒中心向外扩张 m 像素（用于霓虹光晕）"""
    xs = [p[0] for p in points]
    ys = [p[1] for p in points]
    w = max(xs) - min(xs) or 1
    h = max(ys) - min(ys) or 1
    kx = (w + 2 * m) / w
    ky = (h + 2 * m) / h
    cx, cy = sum(xs) / len(xs), sum(ys) / len(ys)
    return [(cx + (x - cx) * kx, cy + (y - cy) * ky) for x, y in points]


def draw_neon_polygon(screen, points, color):
    """霓虹光晕多边形：两层放大的暗色光晕 + 本体"""
    pygame.draw.polygon(screen, scaled_color(color, 0.22), grow_polygon(points, 9))
    pygame.draw.polygon(screen, scaled_color(color, 0.50), grow_polygon(points, 4))
    pygame.draw.polygon(screen, color, points)


def arrow_polygon(rect, direction):
    """在 rect 范围内生成一个朝 direction 方向的箭头多边形（箭杆 + 三角箭头）"""
    x0, y0 = rect.left, rect.top
    x1, y1 = rect.right, rect.bottom
    cx, cy = rect.center
    head = (x1 - x0) * 0.42        # 三角箭头长度
    head_half = (y1 - y0) * 0.30   # 三角箭头半高
    shaft_half = (y1 - y0) * 0.15  # 箭杆半粗
    if direction == "right":
        bx = x1 - head
        return [(x0, cy - shaft_half), (bx, cy - shaft_half), (bx, cy - head_half),
                (x1, cy), (bx, cy + head_half), (bx, cy + shaft_half), (x0, cy + shaft_half)]
    if direction == "left":
        bx = x0 + head
        return [(x1, cy - shaft_half), (bx, cy - shaft_half), (bx, cy - head_half),
                (x0, cy), (bx, cy + head_half), (bx, cy + shaft_half), (x1, cy + shaft_half)]
    if direction == "down":
        by = y1 - head
        return [(cx - shaft_half, y0), (cx - shaft_half, by), (cx - head_half, by),
                (cx, y1), (cx + head_half, by), (cx + shaft_half, by), (cx + shaft_half, y0)]
    # up
    by = y0 + head
    return [(cx - shaft_half, y1), (cx - shaft_half, by), (cx - head_half, by),
            (cx, y0), (cx + head_half, by), (cx + shaft_half, by), (cx + shaft_half, y1)]


def draw_heart(screen, cx, cy, size, color, filled=True):
    """在 (cx, cy) 处矢量绘制一个心形（不依赖字体字形），size 为心形宽高"""
    r = max(2, size // 4)
    if filled:
        pygame.draw.circle(screen, color, (cx - r, cy - r), r)
        pygame.draw.circle(screen, color, (cx + r, cy - r), r)
        pygame.draw.polygon(screen, color,
                            [(cx - 2 * r, cy - r + 1), (cx + 2 * r, cy - r + 1), (cx, cy + 2 * r)])
    else:
        pygame.draw.circle(screen, color, (cx - r, cy - r), r, 2)
        pygame.draw.circle(screen, color, (cx + r, cy - r), r, 2)
        pygame.draw.polygon(screen, color,
                            [(cx - 2 * r, cy - r + 1), (cx + 2 * r, cy - r + 1), (cx, cy + 2 * r)], 2)


def draw_star(screen, cx, cy, size, color, filled=True):
    """在 (cx, cy) 处矢量绘制一个五角星（星级评价用），size 为外接圆半径"""
    pts = []
    for i in range(10):
        r = size if i % 2 == 0 else size * 0.45
        a = -math.pi / 2 + i * math.pi / 5
        pts.append((cx + r * math.cos(a), cy + r * math.sin(a)))
    pygame.draw.polygon(screen, color, pts, 0 if filled else 2)


# [feat] 实现四个方向的路径检测：只判断同一行（左/右）或同一列（上/下）
def first_arrow_on_path(row, col, direction, arrows, grid):
    """返回 (row, col) 沿 direction 到棋盘边界路径上的第一个箭头，没有则返回 None。

    [fix] 修复向上检测时的数组越界：循环条件统一用 0 <= r < grid 且 0 <= c < grid
    限定索引范围，向上越过第 0 行（r 变为 -1）时安全退出循环，不会访问负数下标。
    """
    dc, dr = DIR_VECTORS[direction]
    r, c = row + dr, col + dc
    while 0 <= r < grid and 0 <= c < grid:
        if (r, c) in arrows:
            return arrows[(r, c)]
        r += dr
        c += dc
    return None


def cell_on_any_ray(row, col, placed, grid):
    """(row, col) 是否落在某个已放置箭头到边界的路径上（即会挡住那个箭头）"""
    for (pr, pc), pd in placed.items():
        dc, dr = DIR_VECTORS[pd]
        r, c = pr + dr, pc + dc
        while 0 <= r < grid and 0 <= c < grid:
            if (r, c) == (row, col):
                return True
            r += dr
            c += dc
    return False


def generate_arrows(grid, count, tangle_bias=0.0):
    """生成一个保证有解（存在 0 失误通关顺序）的随机箭头布局。

    采用反向构造法：按"消除顺序的逆序"逐个放置箭头——先放置的箭头最后被消除，
    后放置的箭头必须保证其到边界的路径上没有已放置的箭头。这样构造出的布局，
    按放置的逆序逐个点击即可全部消除。

    tangle_bias 为"缠绕程度"（0~1）：越大的值，新箭头越倾向于放在已有箭头的
    路径上，使初始棋盘出现更多互相阻挡的箭头链，玩家更难一眼找出安全箭头。
    """
    placed = {}  # (row, col) -> direction
    for _ in range(count):
        cells = [(r, c) for r in range(grid) for c in range(grid) if (r, c) not in placed]
        random.shuffle(cells)
        options = []        # 所有合法放置
        tangle_options = [] # 会挡在已有箭头路径上的放置（布局更缠人）
        for r, c in cells:
            for d in DIR_ORDER:
                if first_arrow_on_path(r, c, d, placed, grid) is None:
                    options.append((r, c, d))
                    if cell_on_any_ray(r, c, placed, grid):
                        tangle_options.append((r, c, d))
        if not options:
            return None  # 没有合法的放置位置（箭头密度过高）
        if tangle_options and random.random() < tangle_bias:
            r, c, d = random.choice(tangle_options)
        else:
            r, c, d = random.choice(options)
        placed[(r, c)] = d
    return placed


def compute_solution(arrows, grid):
    """AI 求解：贪心模拟消除顺序（每一步都点一个路径畅通的箭头），0 失误通关。

    返回 [(row, col), ...] 消除顺序列表；由于关卡布局保证可解，正常不会返回 None。
    """
    remain = dict(arrows)
    order = []
    while remain:
        target = None
        for a in remain.values():
            if first_arrow_on_path(a.row, a.col, a.direction, remain, grid) is None:
                target = a
                break
        if target is None:
            return None
        order.append((target.row, target.col))
        del remain[(target.row, target.col)]
    return order


