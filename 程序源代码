def fmt_time(sec):
    """秒数格式化为 mm:ss"""
    return f"{int(sec) // 60:02d}:{int(sec) % 60:02d}"

def scaled_color(c, f):
    """颜色按系数变暗（用于霓虹光晕与粒子渐隐）"""
    return tuple(int(min(255, x * f)) for x in c)

def lerp_color(c1, c2, t):
    """颜色线性插值，t 取值 0~1"""
    return tuple(int(a + (b - a) * t) for a, b in zip(c1, c2))

def grow_polygon(points, m):
    """多边形按包围盒中心向外扩张 m 像素（用于霓虹光晕）"""
    xs = [p[0] for p in points]
    ys = [p[1] for p in points]
    w = max(xs) - min(xs) or 1
    h = max(ys) - min(ys) or 1
    kx = (w + 2 * m) / w
    ky = (h + 2 * m) / h
    cx, cy = sum(xs) / len(xs), sum(ys) / len(ys)
    return [(cx + (x - cx) * kx, cy + (y - cy) * ky) for x, y in points]

def draw_neon_polygon(screen, points, color):
    """霓虹光晕多边形：两层放大的暗色光晕 + 本体"""
    pygame.draw.polygon(screen, scaled_color(color, 0.22), grow_polygon(points, 9))
    pygame.draw.polygon(screen, scaled_color(color, 0.50), grow_polygon(points, 4))
    pygame.draw.polygon(screen, color, points)

def arrow_polygon(rect, direction):
    """在 rect 范围内生成一个朝 direction 方向的箭头多边形（箭杆 + 三角箭头）"""
    x0, y0 = rect.left, rect.top
    x1, y1 = rect.right, rect.bottom
    cx, cy = rect.center
    head = (x1 - x0) * 0.42        # 三角箭头长度
    head_half = (y1 - y0) * 0.30   # 三角箭头半高
    shaft_half = (y1 - y0) * 0.15  # 箭杆半粗
    if direction == "right":
        bx = x1 - head
        return [(x0, cy - shaft_half), (bx, cy - shaft_half), (bx, cy - head_half),
                (x1, cy), (bx, cy + head_half), (bx, cy + shaft_half), (x0, cy + shaft_half)]
    if direction == "left":
        bx = x0 + head
        return [(x1, cy - shaft_half), (bx, cy - shaft_half), (bx, cy - head_half),
                (x0, cy), (bx, cy + head_half), (bx, cy + shaft_half), (x1, cy + shaft_half)]
    if direction == "down":
        by = y1 - head
        return [(cx - shaft_half, y0), (cx - shaft_half, by), (cx - head_half, by),
                (cx, y1), (cx + head_half, by), (cx + shaft_half, by), (cx + shaft_half, y0)]
    # up
    by = y0 + head
    return [(cx - shaft_half, y1), (cx - shaft_half, by), (cx - head_half, by),
            (cx, y0), (cx + head_half, by), (cx + shaft_half, by), (cx + shaft_half, y1)]

def draw_heart(screen, cx, cy, size, color, filled=True):
    """在 (cx, cy) 处矢量绘制一个心形（不依赖字体字形），size 为心形宽高"""
    r = max(2, size // 4)
    if filled:
        pygame.draw.circle(screen, color, (cx - r, cy - r), r)
        pygame.draw.circle(screen, color, (cx + r, cy - r), r)
        pygame.draw.polygon(screen, color,
                            [(cx - 2 * r, cy - r + 1), (cx + 2 * r, cy - r + 1), (cx, cy + 2 * r)])
    else:
        pygame.draw.circle(screen, color, (cx - r, cy - r), r, 2)
        pygame.draw.circle(screen, color, (cx + r, cy - r), r, 2)
        pygame.draw.polygon(screen, color,
                            [(cx - 2 * r, cy - r + 1), (cx + 2 * r, cy - r + 1), (cx, cy + 2 * r)], 2)

def draw_star(screen, cx, cy, size, color, filled=True):
    """在 (cx, cy) 处矢量绘制一个五角星（星级评价用），size 为外接圆半径"""
    pts = []
    for i in range(10):
        r = size if i % 2 == 0 else size * 0.45
        a = -math.pi / 2 + i * math.pi / 5
        pts.append((cx + r * math.cos(a), cy + r * math.sin(a)))
    pygame.draw.polygon(screen, color, pts, 0 if filled else 2)

# [feat] 实现四个方向的路径检测：只判断同一行（左/右）或同一列（上/下）
def first_arrow_on_path(row, col, direction, arrows, grid):
    """返回 (row, col) 沿 direction 到棋盘边界路径上的第一个箭头，没有则返回 None。

    [fix] 修复向上检测时的数组越界：循环条件统一用 0 <= r < grid 且 0 <= c < grid
    限定索引范围，向上越过第 0 行（r 变为 -1）时安全退出循环，不会访问负数下标。
    """
    dc, dr = DIR_VECTORS[direction]
    r, c = row + dr, col + dc
    while 0 <= r < grid and 0 <= c < grid:
        if (r, c) in arrows:
            return arrows[(r, c)]
        r += dr
        c += dc
    return None


def cell_on_any_ray(row, col, placed, grid):
    """(row, col) 是否落在某个已放置箭头到边界的路径上（即会挡住那个箭头）"""
    for (pr, pc), pd in placed.items():
        dc, dr = DIR_VECTORS[pd]
        r, c = pr + dr, pc + dc
        while 0 <= r < grid and 0 <= c < grid:
            if (r, c) == (row, col):
                return True
            r += dr
            c += dc
    return False


def generate_arrows(grid, count, tangle_bias=0.0):
    """生成一个保证有解（存在 0 失误通关顺序）的随机箭头布局。

    采用反向构造法：按"消除顺序的逆序"逐个放置箭头——先放置的箭头最后被消除，
    后放置的箭头必须保证其到边界的路径上没有已放置的箭头。这样构造出的布局，
    按放置的逆序逐个点击即可全部消除。

    tangle_bias 为"缠绕程度"（0~1）：越大的值，新箭头越倾向于放在已有箭头的
    路径上，使初始棋盘出现更多互相阻挡的箭头链，玩家更难一眼找出安全箭头。
    """
    placed = {}  # (row, col) -> direction
    for _ in range(count):
        cells = [(r, c) for r in range(grid) for c in range(grid) if (r, c) not in placed]
        random.shuffle(cells)
        options = []        # 所有合法放置
        tangle_options = [] # 会挡在已有箭头路径上的放置（布局更缠人）
        for r, c in cells:
            for d in DIR_ORDER:
                if first_arrow_on_path(r, c, d, placed, grid) is None:
                    options.append((r, c, d))
                    if cell_on_any_ray(r, c, placed, grid):
                        tangle_options.append((r, c, d))
        if not options:
            return None  # 没有合法的放置位置（箭头密度过高）
        if tangle_options and random.random() < tangle_bias:
            r, c, d = random.choice(tangle_options)
        else:
            r, c, d = random.choice(options)
        placed[(r, c)] = d
    return placed

class Arrow:
    """网格中的一个单格箭头"""
    def __init__(self, row, col, direction):
        self.row = row
        self.col = col
        self.direction = direction

class Button:
    """简单的矩形按钮：负责绘制与点击判定"""
    def __init__(self, rect, text, callback, font=FONT_BTN):
        self.rect = pygame.Rect(rect)
        self.text = text
        self.callback = callback
        self.font = font
        self.disabled = False

    def draw(self, screen, mouse):
        hovered = not self.disabled and self.rect.collidepoint(mouse)
        bg, fg, border = BTN_BG, TEXT, BTN_BORDER
        if self.disabled:
            bg, fg, border = BTN_DISABLED_BG, DIM, (48, 54, 82)
        elif hovered:
            bg = BTN_HOVER
        pygame.draw.rect(screen, bg, self.rect, border_radius=10)
        pygame.draw.rect(screen, border, self.rect, 2, border_radius=10)
        surf = self.font.render(self.text, True, fg)
        screen.blit(surf, surf.get_rect(center=self.rect.center))

    def hit(self, pos):
        return self.rect.collidepoint(pos)

class LevelButton(Button):
    """选关界面的关卡按钮：显示关卡号、已获得星级或"未解锁"状态"""
    def __init__(self, rect, level, callback):
        super().__init__(rect, "", callback)
        self.level = level

    def draw(self, screen, mouse, stars, locked):
        hovered = not locked and self.rect.collidepoint(mouse)
        bg = BTN_HOVER if hovered else BTN_BG
        border = ACCENT
        label_color = TEXT
        if locked:
            bg, border, label_color = (22, 25, 44), (48, 54, 82), DIM
        pygame.draw.rect(screen, bg, self.rect, border_radius=12)
        pygame.draw.rect(screen, border, self.rect, 2, border_radius=12)
        label = FONT_MED.render(f"第 {self.level} 关", True, label_color)
        screen.blit(label, label.get_rect(center=(self.rect.centerx, self.rect.top + 26)))
        if locked:
            t = FONT_SMALL.render("未解锁", True, DIM)
            screen.blit(t, t.get_rect(center=(self.rect.centerx, self.rect.top + 58)))
        else:
            for i in range(3):
                draw_star(screen, self.rect.centerx - 26 + i * 26, self.rect.top + 58, 10,
                          GOLD if i < stars else (60, 70, 110), filled=i < stars)
# 【核心】点击箭头：路径检测 -> 飞出消除 或 碰撞反馈
def click_arrow(self, arrow):
    rect = self.cell_rect(arrow.row, arrow.col)
    blocker = first_arrow_on_path(arrow.row, arrow.col, arrow.direction,
                                  self.arrows, self.grid)
    if blocker is not None:
        # 路径上有其他箭头：无法消除，消耗 1 次失误机会并提示碰撞
        self.mistakes_left -= 1
        self.score = max(0, self.score - 30)
        play_sound("hit")
        self.anim = {"kind": "shake", "arrow": arrow, "blocker": blocker,
                     "t": 0.0, "dur": 0.45}
        self.floaters.append({"text": "被挡住了！", "x": rect.centerx,
                              "y": rect.top - 6, "t": 0.0, "dur": 0.9})
        if self.mistakes_left <= 0:
            self.set_state("fail")
    else:
        # 路径畅通：箭头飞出棋盘
        play_sound("fly")
        dc, dr = DIR_VECTORS[arrow.direction]
        self.anim = {"kind": "fly", "arrow": arrow, "dc": dc, "dr": dr,
                     "rect0": rect, "dist": self.fly_distance(arrow.direction, rect),
                     "t": 0.0, "dur": 0.35}

def fly_distance(self, direction, rect):
    """箭头飞到完全离开棋盘所需的移动距离"""
    br = self.board_rect()
    if direction == "right":
        return br.right - rect.left + 20
    if direction == "left":
        return rect.right - br.left + 20
    if direction == "down":
        return br.bottom - rect.top + 20
    return rect.bottom - br.top + 20

def spawn_particles(self, x, y, color):
    """在箭头飞出棋盘的位置生成一圈光点粒子"""
    for _ in range(12):
        ang = random.uniform(0, 2 * math.pi)
        spd = random.uniform(70, 240)
        self.particles.append({"x": x, "y": y,
                               "vx": math.cos(ang) * spd, "vy": math.sin(ang) * spd,
                               "t": 0.0, "dur": random.uniform(0.25, 0.55), "color": color})

def finish_anim(self):
    """动画结束回调：飞出动画在此真正消除箭头、计分并判定胜负"""
    anim, self.anim = self.anim, None
    if anim["kind"] == "fly":
        arrow = anim["arrow"]
        del self.arrows[(arrow.row, arrow.col)]
        self.score += 100
        self.undo_stack.append((arrow.row, arrow.col, arrow.direction))
        if self.hint and self.hint["cell"] == (arrow.row, arrow.col):
            self.hint = None
        ex = anim["rect0"].centerx + anim["dc"] * anim["dist"]
        ey = anim["rect0"].centery + anim["dr"] * anim["dist"]
        self.spawn_particles(ex, ey, DIR_COLORS[arrow.direction])
        if not self.arrows:      # 本关箭头全部消除 -> 过关
            self.set_state("win")
        elif self.ai_solving:
            self.ai_step()
    # shake 动画结束无需额外处理（颜色在绘制时已恢复）

def draw_shaking_arrow(self, screen):
    a = self.anim
    arrow = a["arrow"]
    p = a["t"] / a["dur"]
    # 晃动：上下箭头左右晃、左右箭头上下晃，幅度逐渐衰减
    off = math.sin(p * math.pi * 5) * 5 * (1 - p)
    rect = self.cell_rect(arrow.row, arrow.col)
    if arrow.direction in ("up", "down"):
        rect = rect.move(round(off), 0)
    else:
        rect = rect.move(0, round(off))
    # 红色闪烁
    color = lerp_color(DIR_COLORS[arrow.direction], RED, math.sin(p * math.pi))
    self.draw_arrow(screen, arrow, rect, color)
class Game:
    """游戏主逻辑：选关、关卡管理、点击判定、动画、音效与绘制"""
    def __init__(self):
        self.quit = False
        self.progress = load_progress()   # 存档：解锁进度 / 星级 / 无尽最高分
        self.state = "menu"               # menu / play / win / fail
        self.mode = "level"               # level（固定关卡）/ endless（无尽模式）
        self.level = 1
        self.anim = None                  # 当前播放的动画
        self.floaters = []                # 浮动提示文字
        self.particles = []               # 粒子（箭头飞出时的光点）
        self.overlay_btns = []            # 结算界面按钮
        self.ai_solving = False           # AI 求解中
        self.ai_order = []                # AI 预计算的消除顺序
        self.hint = None                  # 提示高亮：{"cell": (r,c), "t": 剩余秒}
        self.hints_left = 3               # 本关剩余提示次数
        self.undo_stack = []              # 已消除箭头的撤销栈
        self.elapsed = 0.0                # 本关用时
        self.score = 0                    # 本关得分
        self.win_stars = 0                # 本关获胜星级
        # 游戏中的四个操作按钮
        self.play_btns = []
        x = (WINDOW_W - 150 - 150 - 120 - 160 - 12 * 3) // 2
        for text, w, cb in (("重新开始本关", 150, self.restart_level),
                            ("提示 ×3", 150, self.use_hint),
                            ("撤销", 120, self.undo_last),
                            ("AI 求解", 160, self.start_ai_solve)):
            self.play_btns.append(Button(pygame.Rect(x, 772, w, 40), text, cb))
            x += w + 12
        self.restart_btn, self.hint_btn, self.undo_btn, self.ai_btn = self.play_btns
        # 选关界面按钮
        self.level_btns = []
        for n in range(1, len(LEVELS) + 1):
            col, row = (n - 1) % 3, (n - 1) // 3
            self.level_btns.append(LevelButton(pygame.Rect(55 + col * 190, 220 + row * 100, 170, 80),
                                               n, lambda n=n: self.start_level(n)))
        self.menu_btns = [
            Button(pygame.Rect(0, 0, 300, 54), "无尽模式", self.start_endless),
            Button(pygame.Rect(0, 0, 300, 54), "退出游戏", self.quit_game),
        ]
        self.menu_btns[0].rect.center = (WINDOW_W // 2, 470)
        self.menu_btns[1].rect.center = (WINDOW_W // 2, 545)

    # ---------------- 关卡管理 ----------------
    def load_level(self, level):
        self.mode = "level"
        self.level = level
        grid, count, mistakes, bias = LEVELS[level - 1]
        self.grid = grid
        layout = None
        while layout is None:
            for _ in range(100):      # 多次随机尝试，避免密度过高时生成失败
                layout = generate_arrows(grid, count, bias)
                if layout is not None:
                    break
            if layout is None:        # 仍然失败则降低箭头数量再试
                count -= 1
        self.layout = layout
        self.mistakes_total = mistakes
        self._reset_level()

    def load_endless(self, index):
        """无尽模式：难度随层数持续递增，上限封顶后保持不变（保证可生成）"""
        self.mode = "endless"
        self.level = index
        grid = min(4 + (index - 1) // 3, 6)
        count = min({4: 8, 5: 13, 6: 20}[grid], 4 + 2 * index)
        mistakes = max(2, 5 - (index - 1) // 3)
        bias = min(0.8, 0.05 + 0.1 * index)
        self.grid = grid
        layout = None
        while layout is None:
            for _ in range(100):
                layout = generate_arrows(grid, count, bias)
                if layout is not None:
                    break
            if layout is None:
                count -= 1
        self.layout = layout
        self.mistakes_total = mistakes
        self._reset_level()

    def _reset_level(self):
        """进入/重开一关：布局不变，重置箭头、失误机会与本关全部统计"""
        self.arrows = {(r, c): Arrow(r, c, d) for (r, c), d in self.layout.items()}
        self.mistakes_left = self.mistakes_total
        self.anim = None
        self.floaters.clear()
        self.particles.clear()
        self.overlay_btns = []
        self.ai_solving = False
        self.ai_order = []
        self.hint = None
        self.hints_left = 3
        self.undo_stack = []
        self.elapsed = 0.0
        self.score = 0
        self.state = "play"

    def restart_level(self):
        self._reset_level()

    def start_level(self, n):
        self.load_level(n)

    def start_endless(self):
        self.load_endless(1)

    def next_level(self):
        if self.mode == "endless":
            self.load_endless(self.level + 1)
        elif self.level < len(LEVELS):
            self.load_level(self.level + 1)
        else:
            self.enter_menu()

    def enter_menu(self):
        self.state = "menu"
        self.anim = None
        self.ai_solving = False

    def quit_game(self):
        self.quit = True
