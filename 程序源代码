    def draw_play(self, screen):
        mouse = pygame.mouse.get_pos()
        screen.fill(BG)

        # 顶部信息栏：关卡 / 时间 / 得分 / 失误机会
        mode_label = f"第 {self.level} 关" if self.mode == "level" else f"无尽 · 第 {self.level} 关"
        level_surf = FONT_MED.render(mode_label, True, TEXT)
        screen.blit(level_surf, (30, 26))
        time_surf = FONT_MED.render(f"时间 {fmt_time(self.elapsed)}", True, TEXT)
        screen.blit(time_surf, (WINDOW_W - time_surf.get_width() - 30, 26))
        score_surf = FONT_MED.render(f"得分 {self.score}", True, TEXT)
        screen.blit(score_surf, (30, 64))
        mis_label = FONT_MED.render("失误机会：", True, TEXT)
        heart_w = 26
        x0 = WINDOW_W - 30 - mis_label.get_width() - self.mistakes_total * heart_w
        screen.blit(mis_label, (x0, 64))
        for i in range(self.mistakes_total):   # 心形矢量绘制，剩余实心红、失去空心灰
            hx = x0 + mis_label.get_width() + 13 + i * heart_w
            draw_heart(screen, hx, 78, 20, RED if i < self.mistakes_left else HEART_EMPTY,
                       filled=i < self.mistakes_left)
        if self.ai_solving:
            ai = FONT_SMALL.render("AI 求解中…", True, ACCENT)
            screen.blit(ai, ai.get_rect(center=(WINDOW_W // 2, 100)))

        # [feat] 完成游戏棋盘和箭头显示：绘制棋盘背景、网格线与四个方向的箭头
        br = self.board_rect()
        pygame.draw.rect(screen, scaled_color(ACCENT, 0.18), br.inflate(12, 12), 2, border_radius=16)
        pygame.draw.rect(screen, BOARD_BG, br, border_radius=12)
        pygame.draw.rect(screen, BOARD_EDGE, br, 2, border_radius=12)
        for r in range(self.grid):
            for c in range(self.grid):
                pygame.draw.rect(screen, CELL_BORDER, self.cell_rect(r, c), 1)

        # 棋盘正下方：剩余箭头数量
        left_surf = FONT_MED.render(f"剩余箭头：{len(self.arrows)} 个", True, TEXT)
        screen.blit(left_surf, left_surf.get_rect(center=(WINDOW_W // 2, br.bottom + 18)))

        # 悬停高亮（仅正常游戏状态且无动画时）
        if self.state == "play" and not self.anim and not self.ai_solving:
            cell = self.cell_at(mouse)
            if cell and cell in self.arrows:
                pygame.draw.rect(screen, CELL_HOVER, self.cell_rect(*cell))

        # 碰撞时高亮显示阻挡的箭头
        if self.anim and self.anim["kind"] == "shake":
            b = self.anim["blocker"]
            pygame.draw.rect(screen, YELLOW, self.cell_rect(b.row, b.col), 3, border_radius=8)

        # 提示功能：高亮脉冲光圈
        if self.hint and self.hint["cell"] in self.arrows:
            r, c = self.hint["cell"]
            rect = self.cell_rect(r, c)
            k = 0.5 + 0.5 * math.sin(pygame.time.get_ticks() * 0.012)
            pygame.draw.rect(screen, scaled_color(YELLOW, 0.35 + 0.45 * k),
                             rect.inflate(int(10 * k), int(10 * k)), 3, border_radius=10)
            pygame.draw.rect(screen, YELLOW, rect, 2, border_radius=8)

        # 绘制箭头（动画中的箭头单独绘制）
        for arrow in self.arrows.values():
            if self.anim and self.anim["kind"] == "fly" and self.anim["arrow"] is arrow:
                continue
            self.draw_arrow(screen, arrow, self.cell_rect(arrow.row, arrow.col),
                            DIR_COLORS[arrow.direction])
        if self.anim and self.anim["kind"] == "fly":
            self.draw_flying_arrow(screen)
        if self.anim and self.anim["kind"] == "shake":
            self.draw_shaking_arrow(screen)

        # 粒子（箭头飞出棋盘时的光点）
        for p in self.particles:
            k = 1 - p["t"] / p["dur"]
            pygame.draw.circle(screen, scaled_color(p["color"], max(0.15, k)),
                               (int(p["x"]), int(p["y"])), max(1, int(3 * k)))

        # 浮动提示文字（碰撞时显示"被挡住了！"并向上飘散）
        for f in self.floaters:
            p = f["t"] / f["dur"]
            surf = FONT_FLOAT.render(f["text"], True, RED)
            surf.set_alpha(int(255 * (1 - p)))
            screen.blit(surf, surf.get_rect(center=(f["x"], f["y"] - 30 * p)))

        # 底部：规则提示 + 方向图例 + 操作按钮
        hint = FONT_SMALL.render("点击箭头：前方无阻挡即可飞出消除；撞到其他箭头消耗 1 次失误机会",
                                 True, HINT)
        screen.blit(hint, hint.get_rect(center=(WINDOW_W // 2, 700)))
        self.draw_legend(screen)
        self.hint_btn.text = f"提示 ×{self.hints_left}"
        self.hint_btn.disabled = self.hints_left <= 0
        self.undo_btn.disabled = not self.undo_stack
        for btn in self.play_btns:
            btn.draw(screen, mouse)

        # 结算遮罩（过关 / 失败）
        if self.state in ("win", "fail"):
            self.draw_overlay(screen, mouse)

    def draw_arrow(self, screen, arrow, rect, color):
        poly = arrow_polygon(rect.inflate(-28, -28), arrow.direction)
        draw_neon_polygon(screen, poly, color)

    def draw_flying_arrow(self, screen):
        """飞出动画：缓动加速 + 逐渐缩小 + 拖尾残影，模拟飞远"""
        a = self.anim
        arrow = a["arrow"]
        p = min(a["t"] / a["dur"], 1.0)
        pe = 1 - (1 - p) ** 2                  # 缓出：越飞越快
        d = a["dist"] * pe
        for ghost in range(3, 0, -1):          # 拖尾残影
            rect = a["rect0"].move(round(a["dc"] * d * (1 - 0.14 * ghost)),
                                   round(a["dr"] * d * (1 - 0.14 * ghost)))
            poly = arrow_polygon(rect.inflate(-28, -28), arrow.direction)
            pygame.draw.polygon(screen, scaled_color(DIR_COLORS[arrow.direction],
                                                     0.10 * ghost), poly)
        rect = a["rect0"].move(round(a["dc"] * d), round(a["dr"] * d))
        k = 0.3 * p                            # 逐渐缩小，模拟飞远
        rect = rect.inflate(-round(rect.width * k), -round(rect.height * k))
        self.draw_arrow(screen, arrow, rect, DIR_COLORS[arrow.direction])

    def draw_shaking_arrow(self, screen):
        a = self.anim
        arrow = a["arrow"]
        p = a["t"] / a["dur"]
        # 晃动：上下箭头左右晃、左右箭头上下晃，幅度逐渐衰减
        off = math.sin(p * math.pi * 5) * 5 * (1 - p)
        rect = self.cell_rect(arrow.row, arrow.col)
        if arrow.direction in ("up", "down"):
            rect = rect.move(round(off), 0)
        else:
            rect = rect.move(0, round(off))
        # 红色闪烁
        color = lerp_color(DIR_COLORS[arrow.direction], RED, math.sin(p * math.pi))
        self.draw_arrow(screen, arrow, rect, color)

    def draw_legend(self, screen):
        """底部图例：展示四个方向对应的霓虹颜色"""
        item_w = 76
        start = WINDOW_W // 2 - len(DIR_ORDER) * item_w // 2
        for i, d in enumerate(DIR_ORDER):
            cx = start + i * item_w + item_w // 2
            rect = pygame.Rect(0, 0, 22, 22)
            rect.center = (cx - 14, 728)
            pygame.draw.polygon(screen, DIR_COLORS[d], arrow_polygon(rect, d))
            name = FONT_SMALL.render(DIR_NAMES[d], True, HINT)
            screen.blit(name, name.get_rect(midleft=(cx + 1, 728)))

    def draw_overlay(self, screen, mouse):
        """结算面板：过关显示星级/得分/用时，失败显示重试按钮"""
        dim = pygame.Surface((WINDOW_W, WINDOW_H), pygame.SRCALPHA)
        dim.fill((0, 0, 0, 160))
        screen.blit(dim, (0, 0))
        panel = pygame.Rect(0, 0, 460, 280)
        panel.center = (WINDOW_W // 2, WINDOW_H // 2 - 30)
        pygame.draw.rect(screen, PANEL_BG, panel, border_radius=16)
        pygame.draw.rect(screen, ACCENT, panel, 2, border_radius=16)
        if self.state == "win":
            title = f"第 {self.level} 关通过！" if self.mode == "level" else f"无尽 · 第 {self.level} 关通过！"
            if self.mode == "level":
                for i in range(3):     # 星级评价
                    draw_star(screen, WINDOW_W // 2 - 56 + i * 56, panel.top + 104, 22,
                              GOLD if i < self.win_stars else (60, 70, 110),
                              filled=i < self.win_stars)
                used = self.mistakes_total - self.mistakes_left
                sub = f"得分 {self.score} · 用时 {fmt_time(self.elapsed)} · 失误 {used} 次"
            else:
                sub = f"得分 {self.score} · 用时 {fmt_time(self.elapsed)}"
        else:
            title = "本关失败！"
            sub = "失误机会已用完，再试一次吧！"
        t = FONT_OVERLAY.render(title, True, TEXT)
        screen.blit(t, t.get_rect(center=(WINDOW_W // 2, panel.top + 52)))
        s = FONT_SUB.render(sub, True, HINT)
        screen.blit(s, s.get_rect(center=(WINDOW_W // 2, panel.top + 148)))
        for btn in self.overlay_btns:
            btn.draw(screen, mouse)


# ---------------------------------------------------------------------------
# 主循环
# ---------------------------------------------------------------------------
def main():
    pygame.init()
    pygame.display.set_caption("箭头消消乐")
    screen = pygame.display.set_mode((WINDOW_W, WINDOW_H))
    init_sounds()       # 音效初始化（设备不可用时静音运行）
    clock = pygame.time.Clock()
    game = Game()
    # ================= 核心运行代码 =================
    # 游戏主循环三步走：① 处理事件（鼠标点击/关闭窗口）→ ② 更新动画与计时 → ③ 绘制画面
    # 用 clock.tick 固定每秒 60 帧，dt 为帧间隔秒数，保证动画速度与帧率无关
    while not game.quit:
        dt = clock.tick(FPS) / 1000.0
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                game.quit = True
            elif event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                game.handle_click(event.pos)
        game.update(dt)
        game.draw(screen)
        pygame.display.flip()
    pygame.quit()
    sys.exit()


if __name__ == "__main__":
    main()
