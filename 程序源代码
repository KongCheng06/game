def save_path():
    if getattr(sys, "frozen", False):          # PyInstaller 打包后
        return os.path.join(os.path.dirname(sys.executable), "save.json")
    return os.path.join(os.path.dirname(os.path.abspath(__file__)), "save.json")


def load_progress():
    """读取存档：已解锁关卡、各关最好星级、无尽模式最高分"""
    try:
        with open(save_path(), encoding="utf-8") as f:
            data = json.load(f)
        return {"unlocked": int(data.get("unlocked", 1)),
                "stars": {int(k): int(v) for k, v in data.get("stars", {}).items()},
                "endless_best": int(data.get("endless_best", 0))}
    except (OSError, ValueError):
        return {"unlocked": 1, "stars": {}, "endless_best": 0}


def save_progress(progress):
    """写回存档；写入失败不影响游戏运行"""
    try:
        with open(save_path(), "w", encoding="utf-8") as f:
            json.dump(progress, f, ensure_ascii=False, indent=2)
    except OSError:
        pass


